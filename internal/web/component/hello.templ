package component

import (
  "iamcodingabit/go-track-game-objectives/internal/store"
)

templ HelloWorld(gameList []store.Game) {
    @Base("Home") {
      <h1>Skiiwhoa</h1>
      <ul>
        for _, game := range gameList {
          <li>
            {game.Title} <small>{game.Genre}</small>
          </li>
        }
      </ul>
    }
}