package component

templ Base(title string) {
    <!DOCTYPE html>
    <html lang="en">
        <head>
            <meta charset="UTF-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <link rel="stylesheet" href=" https://cdn.jsdelivr.net/npm/@sveti/blades@3/css/blades.min.css"/>
            <title>{title}</title>
        </head>
        <body>
            <header class="container">
                <nav>
                    <ul>
                        <li><strong>go-track-game-objectives</strong></li>
                    </ul>
                    <ul>
                        <li><a href="/">Hello</a></li>
                    </ul>
                </nav>
            </header>
            <main class="container breakout">
                {children...}
            </main>
        </body>
    </html>
}