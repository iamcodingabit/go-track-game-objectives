package component

templ Base(title string) {
    <!DOCTYPE html>
    <html lang="en">
        <head>
            <meta charset="UTF-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <link rel="stylesheet" href=" https://cdn.jsdelivr.net/npm/@sveti/blades@3/css/blades.min.css"/>
            <title>{title}</title>
        </head>
        <body>
            <header>
                <nav>
                    <a href="/">Hello</a>
                </nav>
            </header>
            <main class="container breakout-all">
                {children...}
            </main>
        </body>
    </html>
}